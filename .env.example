# ==========================================================
#  Copie este arquivo para ".env" e preencha os valores.
#  O arquivo .env NAO deve ir para o GitHub (ja esta no .gitignore).
# ==========================================================

# Token do bot: Developer Portal > seu app > Bot > Reset Token
DISCORD_TOKEN=

# Application ID: Developer Portal > seu app > General Information
CLIENT_ID=

# ID do seu servidor (opcional).
# Se preencher, os comandos aparecem na hora, so nesse servidor.
# Se deixar vazio, os comandos sao globais e podem levar ate 1 hora.
GUILD_ID=

# Canais de boas-vindas / despedida (clique com o botao direito no canal > Copiar ID)
WELCOME_CHANNEL_ID=
GOODBYE_CHANNEL_ID=
